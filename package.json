{
  "name": "folio-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Folio workbench",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
