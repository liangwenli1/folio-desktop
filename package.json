{
  "name": "folio-desktop",
  "productName": "Folio",
  "private": true,
  "version": "0.1.0",
  "description": "Folio workbench",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo:capture": "playwright test -c demo",
    "api:types": "openapi-typescript ${API_URL:-http://localhost:47110}/openapi.json -o src/shared/api-schema.d.ts"
  },
  "dependencies": {
    "camoufox": "^0.5.8",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "playwright-core": "^1.62.0",
    "socks": "^2.8.10"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "flag-icons": "^7.6.0",
    "openapi-typescript": "^7.13.0",
    "puppeteer-core": "^24.43.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
